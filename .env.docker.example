# Gaming Store - Docker Environment Configuration
# Copy this file to .env and update the values as needed

# ============================================
# Application Settings
# ============================================
NODE_ENV=production

# ============================================
# Frontend (Next.js) Settings
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost

# Auth.js Settings
NEXTAUTH_URL=http://localhost
NEXTAUTH_SECRET=your-super-secret-key-change-this-in-production

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Stripe (Frontend)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ============================================
# Backend (Express) Settings
# ============================================
PORT=5000
FRONTEND_URL=http://localhost

# Database
MONGODB_URI=mongodb://mongo:27017/gaming-store

# Redis
REDIS_URL=redis://redis:6379

# JWT Settings
JWT_ACCESS_SECRET=your-jwt-access-secret-change-this
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Stripe (Backend)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SSLCommerz (Optional - Bangladesh Payment Gateway)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
